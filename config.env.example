# ===========================================================================
# Netskope GenAI Export -- configuration
# ===========================================================================
# Copy this file to "config.env" in the same folder as the script and fill
# it in.
#
#   cp config.env.example config.env
#
# The script looks for these names, in order, next to itself:
#     config.env  ->  api_tokens.env  ->  config.ini  ->  .env
# Or point it anywhere with the NETSKOPE_CONFIG_FILE environment variable,
# which is how you run UAT and PROD from the same folder:
#     NETSKOPE_CONFIG_FILE=/etc/netskope/prod.env python export_...py
#
# SECURITY
#   config.env holds live secrets. Do NOT commit it to git (add
#   "config.env" to .gitignore) and lock the file down on the server:
#     Linux    : chmod 600 config.env
#     Windows  : restrict to the service account via file Properties >
#                Security; remove Users/Everyone
#
# FORMAT
#   KEY=value        (no spaces around "=", no quotes needed)
#   Lines starting with # are comments. Blank lines are ignored.
#   Values are read as text; true/false/yes/no/1/0 work for on-off settings.
# ===========================================================================


# --- Netskope --------------------------------------------------------------

# Tenant URL, no trailing slash.
NETSKOPE_BASE_URL=https://yourtenant.goskope.com

# REST API v2 token (Settings > Tools > REST API v2).
NETSKOPE_API_TOKEN=

# Auth header style: "bearer" or "netskope".
# If you get 401s from Netskope, flip this to the other value.
NETSKOPE_AUTH_MODE=bearer

# Endpoint. The datasearch endpoint is the one that supports the query
# filter -- don't change this unless you know why.
NETSKOPE_ENDPOINT_PATH=/api/v2/events/datasearch/application


# --- What to pull ----------------------------------------------------------

# The application category to filter on.
FILTER_FIELD=appcategory
FILTER_VALUE=Generative AI
FILTER_OPERATOR=in

# Which day: yesterday | today | date | rolling
DAY_MODE=yesterday

# Only used when DAY_MODE=date
TARGET_DATE=2026-07-19

# Records per page (Netskope caps at 10000).
PAGE_SIZE=5000

# Split the day into windows of this many seconds to keep pagination
# correct on high-volume days. 0 disables windowing.
TIME_WINDOW_SECONDS=3600

# Server-side query timeout in seconds.
QUERY_TIMEOUT=180


# --- Output ----------------------------------------------------------------

# Folder for the generated CSVs. Use an absolute path for scheduled runs.
#   Linux   : /opt/netskope/output
#   Windows : C:\Netskope\output
OUTPUT_DIR=./output

OUTPUT_FILE=GenerativeAI_Applications.csv

# Append the exported day to the filename.
DATE_STAMP_FILENAME=true

# Skip the run entirely if that day's file already exists.
SKIP_IF_EXISTS=true

# Date format in the CSV. %m/%d/%Y = 07/29/2026
DATE_FORMAT=%m/%d/%Y


# --- Logging ---------------------------------------------------------------

LOG_DIR=./logs

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Keep this many days of live logs, then archive them into a zip.
LOG_RETENTION_DAYS=20

# Delete archived zips older than this. 0 = keep archives forever.
ARCHIVE_RETENTION_DAYS=180


# --- SharePoint upload -----------------------------------------------------

# false = write the CSV locally only, don't upload.
SHAREPOINT_ENABLED=true

# Entra ID app registration (SPN) -- the three static values your admin
# gave you when the service principal was created.
#
#   Tenant ID      -> SPN_TENANT_ID       (aka Directory ID)
#   Client ID      -> SPN_CLIENT_ID       (aka Application ID)
#   Client Secret  -> SPN_CLIENT_SECRET   (the "secret key" / SP token)
#
# NOTE: there is no access token to configure here. The script exchanges
# these three for a short-lived Microsoft Graph access token on every run.
# That token lives about an hour and is never stored.
#
# Unrelated to NETSKOPE_API_TOKEN above -- that one reads data OUT of
# Netskope; these three write the CSV INTO SharePoint.
SPN_TENANT_ID=
SPN_CLIENT_ID=
SPN_CLIENT_SECRET=

# Target site. Leave SHAREPOINT_SITE_ID blank to resolve it from the
# hostname + path automatically.
SHAREPOINT_SITE_HOSTNAME=yourtenant.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/YourSiteName
SHAREPOINT_SITE_ID=

# Document library. "Documents" is the default library on most sites.
SHAREPOINT_LIBRARY_NAME=Documents
SHAREPOINT_DRIVE_ID=

# Folder inside the library. Blank = library root.
SHAREPOINT_FOLDER=Netskope/GenAI

# Overwrite a file of the same name if it already exists up there.
SHAREPOINT_REPLACE_EXISTING=true


# --- Misc ------------------------------------------------------------------

# Prompt for the date instead of running unattended. Keep false for
# scheduled runs or the job will hang waiting for input.
INTERACTIVE=false

# Extra request/response detail in the logs. Turn on to troubleshoot.
DEBUG=false
